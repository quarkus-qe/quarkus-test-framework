<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <servers/>
    <profiles>
        <profile>
            <id>google-mirror</id>
            <repositories>
                <repository>
                    <id>google-maven-central</id>
                    <name>GCS Maven Central mirror US</name>
                    <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>google-maven-central</id>
                    <name>GCS Maven Central mirror US</name>
                    <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>google-mirror</activeProfile>
    </activeProfiles>
</settings>
